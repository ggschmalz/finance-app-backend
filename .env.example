# ==========================================
# Configurações do Django
# ==========================================
# Gere uma nova chave para produção. Para testes locais, qualquer string longa serve.
SECRET_KEY=sua_chave_secreta_muito_longa_aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# ==========================================
# Configurações do Banco de Dados (PostgreSQL)
# ==========================================
DB_NAME=finance_db
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres_aqui
# No Docker Compose, o host do banco de dados é 'db'.
# Para rodar fora do Docker (localmente na máquina), use 'localhost'.
DB_HOST=localhost
DB_PORT=5432

# ==========================================
# Autenticação Google OAuth2
# ==========================================
# Cole aqui o Client ID gerado no Google Cloud Console
GOOGLE_OAUTH2_CLIENT_ID=662162479617-pnmkdj5j19vkju5nucuvbmtbll6lv6ip.apps.googleusercontent.com
